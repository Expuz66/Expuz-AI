<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Development-only override. Cleartext is permitted by the platform, but
      UrlPolicy still rejects HTTP for anything that is not a private LAN host.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
