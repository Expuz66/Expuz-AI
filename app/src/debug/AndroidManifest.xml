<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Debug builds allow cleartext transport so an explicit LAN development
      server (http://192.168.x.x:8080) can be reached. The app still enforces
      at runtime that cleartext is only used for private/LAN hostnames.
      Release builds also allow the platform transport; UrlPolicy still limits
      HTTP server URLs to private/LAN hosts.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
