<?xml version="1.0" encoding="utf-8"?>
<!--
  Shape of the glass bar: a faint tint plus rounded bottom corners. The
  background also supplies the outline used by clipToOutline so the blurred
  layer and scrim are clipped to the same rounded rectangle.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/expuz_glass_base" />
    <corners android:radius="30dp" />
    <stroke
        android:width="1dp"
        android:color="@color/expuz_glass_hairline" />
</shape>
